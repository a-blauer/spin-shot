{"w": 320, "h": 180, "query": "&map=2&scan=1", "steps": [{"js": "(()=>{const W=__dmh.world,o=[];for(const r of W.scanAll){const b=r[3];if(Math.abs((b.min.x+b.max.x)/2+4940)<80&&Math.abs((b.min.z+b.max.z)/2-150)<80&&b.max.y>350&&b.min.y<700)o.push([r[0],r[1],r[5]==='hang'?'H':'',[b.min.x,b.min.y,b.min.z,b.max.x,b.max.y,b.max.z].map(v=>Math.round(v))]);}return JSON.stringify(o)})()"}]}