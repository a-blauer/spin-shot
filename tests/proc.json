{"w":640,"h":360,"steps":[{"js":"const g=__dmh,P=g.player,U=g.data.upgrades;const id=n=>U.findIndex(u=>u.name===n);P.addUpgrade(id('Bladestorm'));P.addUpgrade(id('Chain Reaction'));let n=0;const o=P.executeProc.bind(P);P.executeProc=function(u,...a){n++;return o(u,...a)};for(let k=0;k<10;k++){P.runProcs('OnMeleeKill',null,P.pos,0,1);P.runProcs('OnKill',null,P.pos,0,1);}const a=n;__sim(200);P.runProcs('OnMeleeKill',null,P.pos,0,1);JSON.stringify([a,n,U[id('Bladestorm')].cd,U[id('Bladestorm')].desc])"}]}
