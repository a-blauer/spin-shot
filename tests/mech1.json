{"js":"window.__dmhHold=true;const g=__dmh,P=g.player;g.godMode=false;P.invuln=0;for(let i=0;i<g.zones.length;i++)g.unlockZone(i,true);for(const I of g.interactables)if(I.type==='Door'&&!I.open)g.openDoor(I);g.phase='Intermission';g.phaseTimer=1e9;const L=g.mech.lift.ends;const out={ends:L.map(I=>[Math.round(I.pos.x),Math.round(I.pos.y),Math.round(I.pos.z)])};P.pos.set(L[0].pos.x+60,114,L[0].pos.z);__sim(5);out.focus=P.focus&&P.focus.prompt(P);P.interact();__sim(3);out.afterNoPower=[Math.round(P.pos.x),Math.round(P.pos.y),Math.round(P.pos.z)];g.quest.i=1;g.mech.cd=0;__sim(3);out.prompt2=P.focus&&P.focus.prompt(P);P.interact();__sim(30);out.down=[Math.round(P.pos.x),Math.round(P.pos.y),Math.round(P.pos.z)];g.mech.cd=0;__sim(3);out.prompt3=P.focus&&P.focus.prompt(P);P.interact();__sim(30);out.up=[Math.round(P.pos.x),Math.round(P.pos.y),Math.round(P.pos.z)];P.pos.set(0,114,3300);P.vel.set(0,0,600);for(let k=0;k<120;k++)__sim(1,{fwd:1});out.balcony=[Math.round(P.pos.x),Math.round(P.pos.y),Math.round(P.pos.z)];out.zone=g.zones[g.zoneAt(P.pos)].name;JSON.stringify(out)"}]}
